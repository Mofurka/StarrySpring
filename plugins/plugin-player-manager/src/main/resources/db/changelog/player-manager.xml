<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="playerManagerSchema" value="player_manager"/>

    <changeSet id="player-manager-001-create-schema" author="Mofurka">
        <sql dbms="postgresql">
            CREATE SCHEMA IF NOT EXISTS ${playerManagerSchema};
        </sql>
    </changeSet>


    <changeSet id="player-manager-002-create-players" author="Mofurka">
        <createTable
                schemaName="${playerManagerSchema}"
                tableName="players">

            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="player_uuid" type="varchar(32)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="ip_address" type="varchar(45)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="java.sql.Types.TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="last_seen" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="player-manager-003-create-player-roles" author="Mofurka">
        <createTable
                schemaName="${playerManagerSchema}"
                tableName="player_roles">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="player_uuid" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="role_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="assigned_by" type="varchar(255)"/>

            <column name="assigned_at" type="java.sql.Types.TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                schemaName="${playerManagerSchema}"
                tableName="player_roles"
                columnNames="player_uuid, role_name"
                constraintName="uk_player_manager_player_roles_uuid_role"/>

        <createIndex
                schemaName="${playerManagerSchema}"
                tableName="player_roles"
                indexName="idx_player_manager_player_roles_uuid">
            <column name="player_uuid"/>
        </createIndex>
    </changeSet>

    <changeSet id="player-manager-004-create-player-permission-overrides" author="Mofurka">
        <createTable
                schemaName="${playerManagerSchema}"
                tableName="player_permission_overrides">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="player_uuid" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="permission_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="granted" type="boolean">
                <constraints nullable="false"/>
            </column>

            <column name="changed_by" type="varchar(255)"/>

            <column name="changed_at" type="java.sql.Types.TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                schemaName="${playerManagerSchema}"
                tableName="player_permission_overrides"
                columnNames="player_uuid, permission_name"
                constraintName="uk_player_manager_permission_overrides_uuid_permission"/>

        <createIndex
                schemaName="${playerManagerSchema}"
                tableName="player_permission_overrides"
                indexName="idx_player_manager_permission_overrides_uuid">
            <column name="player_uuid"/>
        </createIndex>
    </changeSet>

    <changeSet id="player-manager-005-create-player-ip-history" author="Mofurka">
        <createTable
                schemaName="${playerManagerSchema}"
                tableName="player_ip_history">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="player_uuid" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="ip_address" type="varchar(45)">
                <constraints nullable="false"/>
            </column>

            <column name="first_seen" type="java.sql.Types.TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="last_seen" type="java.sql.Types.TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="connection_count" type="bigint" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                schemaName="${playerManagerSchema}"
                tableName="player_ip_history"
                columnNames="player_uuid, ip_address"
                constraintName="uk_player_manager_ip_history_uuid_ip"/>

        <createIndex
                schemaName="${playerManagerSchema}"
                tableName="player_ip_history"
                indexName="idx_player_manager_ip_history_ip">
            <column name="ip_address"/>
        </createIndex>
    </changeSet>

    <changeSet id="player-manager-006-backfill-player-ip-history" author="Mofurka">
        <comment>
            Переносит текущий адрес каждого игрока в историю, чтобы поиск связей
            работал и по тем, кто уже заходил до появления таблицы
        </comment>
        <sql dbms="postgresql">
            INSERT INTO ${playerManagerSchema}.player_ip_history
                (id, player_uuid, ip_address, first_seen, last_seen, connection_count)
            SELECT gen_random_uuid(), p.player_uuid, p.ip_address, p.created_at, p.last_seen, 1
            FROM ${playerManagerSchema}.players p
            WHERE p.ip_address IS NOT NULL
              AND p.ip_address &lt;&gt; ''
            ON CONFLICT ON CONSTRAINT uk_player_manager_ip_history_uuid_ip DO NOTHING;
        </sql>
    </changeSet>

</databaseChangeLog>